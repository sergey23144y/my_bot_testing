# Игнорируем виртуальные окружения
venv/
.env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Игнорируем логи
*.log
logs/
*.out
*.err

# Игнорируем кэш pytest / mypy / других инструментов
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Игнорируем редакторские и IDE файлы
.vscode/
*.swp
*.swo

# Игнорируем системные файлы
.DS_Store
Thumbs.db

# Игнорируем артефакты сборки
build/
dist/
*.egg-info/
.eggs/

# Игнорируем докер файлы для локальной разработки
docker-compose.override.yml

# Игнорируем все .env (если не используешь отдельный шаблон)
.env
*.env

# Если есть тесты, которые не нужны в продакшене (опционально)
tests/